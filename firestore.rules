rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL SAFETY NET ---
    // أي مسار غير مذكور صراحةً ممنوع تماماً (قراءةً وكتابةً).
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- PER-PHARMACY DATA ISOLATION ---
    // كل صيدلية (مستخدم) تملك بياناتها فقط. لا يمكن لأي مستخدم آخر
    // قراءة أو تعديل بيانات صيدلية غيره مهما حدث. هذا هو الحدّ الأمني
    // الأساسي الذي يجعل العمل على عدة أجهزة آمناً ومتزامناً.
    match /users/{userId} {
      // ملف الصيدلية نفسه: مالكها فقط (لا يُحذف نهائياً للحفاظ على السجل).
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // كل المجموعات الفرعية (المخزون، الفواتير، الذمم، المصاريف،
      // الموردون، الموظفون، المرتجعات، سجل التدقيق، طلبيات B2B):
      // مالك الحساب فقط يقرأ ويكتب فيها. المزامنة بين الأجهزة تتم
      // تلقائياً عبر Firestore لأن كل الأجهزة تستخدم نفس الحساب (نفس الـ uid).
      match /{collection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
